{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "slack-trivia",
  "main": "worker/index.ts",
  "tsconfig": "./tsconfig.worker.json",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // One object per Slack channel, addressed by idFromName(channelId).
  "durable_objects": {
    "bindings": [
      {
        "name": "CHANNEL_OBJECT",
        "class_name": "ChannelObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChannelObject"]
    }
  ],
  // Every screening verdict, shared by all channels. Schema in ./migrations.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slack-trivia",
      "database_id": "9fb5de5a-f2b0-486a-8f15-3e04a7d0a15e",
      "migrations_dir": "migrations"
    }
  ],
  // Countdown GIFs are pre-rendered into ./public at build time and served
  // from the same origin as the Slack request URL.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
  // SLACK_BOT_TOKEN, SLACK_SIGNING_SECRET and OPENCODE_API_KEY are set with
  // `wrangler secret put`.
}
