{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "types": [
      "@cloudflare/workers-types/experimental",
      "@cloudflare/vitest-pool-workers",
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // `src/types` carries the ambient module declarations for untyped packages
  // (gifenc), which worker code reaches through the shared `src` modules.
  "include": ["worker/**/*.ts", "test/worker/**/*.ts", "src/types/*.d.ts"]
}
